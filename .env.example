# Supabase Configuration
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: SQL Server Configuration (for data import only)
# These values only work from the company's internal network.
# SEVILLA_SQL_SERVER=192.168.x.x\SQLEXPRESS
# SEVILLA_SQL_DATABASE=EVENTOAB
# SEVILLA_SQL_USER=username
# SEVILLA_SQL_PASSWORD=password
# JEREZ_SQL_SERVER=192.168.x.x\SQLEXPRESS
# JEREZ_SQL_DATABASE=EVENTOAB
# JEREZ_SQL_USER=username
# JEREZ_SQL_PASSWORD=password

# Odoo 19 deterministic export (server-only; never use NEXT_PUBLIC_)
# JSON-2 with Bearer API key. Do not reuse this key for MCP chat.
# ODOO19_URL=https://your-odoo-instance
# ODOO19_DB=your_odoo_database
# ODOO19_API_KEY=your_odoo19_api_key
# ODOO19_SEVILLA_COMPANY=your_visuena_company_name
# ODOO19_JEREZ_COMPANY=your_stileum_company_name

# Chat via OpenRouter (server-only)
# OPENAI_API_KEY=your_openrouter_api_key
# OPENAI_MODEL=openai/gpt-4o-mini

# Odoo 19 MCP chat (server-only, separate read-only key)
# ODOO_MCP_URL=https://your-odoo-instance/mcp
# ODOO_MCP_API_KEY=your_odoo_mcp_readonly_api_key
# ODOO_MCP_DB=your_odoo_database
