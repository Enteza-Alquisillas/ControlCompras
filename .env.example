# Optional: SQL Server Configuration (for data import only)
# Note: These are private IPs and won't work from Vercel
# Use them only for local development and data migration
# SEVILLA_SQL_SERVER=192.168.x.x\SQLEXPRESS
# SEVILLA_SQL_DATABASE=EVENTOAB
# SEVILLA_SQL_USER=username
# SEVILLA_SQL_PASSWORD=password
# JEREZ_SQL_SERVER=192.168.x.x\SQLEXPRESS
# JEREZ_SQL_DATABASE=EVENTOAB
# JEREZ_SQL_USER=username
# JEREZ_SQL_PASSWORD=password

# Odoo 19 Enterprise (server-only; do not expose with NEXT_PUBLIC_)
# Usa la API JSON-2 (/json/2/) con autenticación Bearer por API Key; no requiere usuario/uid.
# Carril determinista de exportación (src/features/odoo19/). No reutilizar esta key para el chat MCP.
# ODOO19_URL=https://enteza19.xtendoo.es
# ODOO19_DB=enteza26
# ODOO19_API_KEY=your_odoo19_api_key
# ODOO19_SEVILLA_COMPANY=VISUEÑA DE MATERIAL PLEGABLE, S.L.
# ODOO19_JEREZ_COMPANY=STILEUM

# Chat Asistente IA (server-only)
# Pese al nombre de src/lib/ai/openrouter.ts, es la clave/modelo de OpenRouter
# (baseURL apunta a https://openrouter.ai/api/v1). El modelo debe ir con el
# prefijo de proveedor de OpenRouter, ej. "openai/gpt-4o-mini", no "gpt-4o-mini".
# OPENAI_API_KEY=your_openrouter_api_key
# OPENAI_MODEL=openai/gpt-4o-mini

# Odoo 19 via MCP (mn_mcp_server) para el chat conversacional (src/features/chat/mcp/).
# Carril distinto del JSON-2 de arriba: protocolo, credencial y ciclo de vida propios.
# API key de solo lectura (perm_read), nunca la misma que ODOO19_API_KEY.
# Instancia multi-base: ODOO_MCP_DB es obligatoria (se envia como cabecera
# X-Odoo-Database); sin ella Odoo responde 404 "No database is selected"
# antes de llegar al controlador /mcp. Puede diferir de ODOO19_DB (bases distintas).
# ODOO_MCP_URL=https://your-odoo-test-instance/mcp
# ODOO_MCP_API_KEY=your_odoo_mcp_readonly_api_key
# ODOO_MCP_DB=your_odoo_database_name
