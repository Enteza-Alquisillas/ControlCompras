{
  "name": "enteza-sync",
  "version": "1.0.0",
  "description": "Servicio de sincronizacion automatica SQL Server -> Supabase",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "sync": "tsx src/index.ts",
    "sync:master": "tsx src/index.ts --only masters",
    "sync:rentals": "tsx src/index.ts --only rentals",
    "test:connections": "tsx src/index.ts --test-connections",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "mssql": "^12.2.0",
    "nodemailer": "^6.9.15",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.9",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
